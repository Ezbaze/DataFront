{
  "name": "openfront-client",
  "type": "module",
  "scripts": {
    "format": "prettier --ignore-unknown --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "scripts:build": "tsc -p ./scripts/tsconfig.json",
    "preopenfront:live-version": "npm run scripts:build --silent",
    "openfront:live-version": "node ./build/scripts/openfront-live-version.js",
    "openfront:live-version:json": "npm run scripts:build --silent && node ./build/scripts/openfront-live-version.js --json",
    "build": "node ./scripts/build-tailwind.cjs && tsc && cross-env GORILLA_BUILD=1 NODE_OPTIONS=\"--require ./scripts/alias-typescript.cjs\" gorilla --input ./build/sidebar/main.js --output ./dist/datafront.user.js --config ./gorilla.json && node ./scripts/normalize-lf.cjs ./dist/datafront.user.js",
    "prepare": "husky install"
  },
  "lint-staged": {
    "{src,scripts,tooling}/**/*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --ignore-unknown --write"
    ],
    "*.{json,md,css,html}": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@tailwindcss/forms": "^0.5.11",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "gorilla-build": "^0.1.16",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "dompurify": "^3.1.7",
    "lucide": "^0.545.0"
  }
}
