{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../build",
    "rootDir": "..",
    "incremental": true,
    "tsBuildInfoFile": "../build/scripts/.tsbuildinfo",
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["./*.ts", "../src/shared/**/*.ts"]
}
